# Kafka
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090

# -----------------------------------------
# IAM SERVICE
# -----------------------------------------

# Application environment (dev, test, prod)
IAM_APP_ENV=dev

# gRPC settings
IAM_GRPC_HOST=0.0.0.0
IAM_GRPC_PORT=50053

# Logger
IAM_LOGGER_LEVEL=info
IAM_LOGGER_AS_JSON=true

# PostgreSQL
IAM_POSTGRES_IMAGE_NAME=postgres:17.0-alpine3.20
IAM_POSTGRES_CONTAINER_HOST=postgres-iam
IAM_POSTGRES_CONTAINER_PORT=5432
IAM_POSTGRES_HOST=localhost
IAM_POSTGRES_PORT=5436
IAM_POSTGRES_USER=iam_user
IAM_POSTGRES_PASSWORD=iam_password
IAM_POSTGRES_DB=iam
IAM_POSTGRES_SSL_MODE=disable
IAM_MIGRATION_DIRECTORY=./iam/migrations

# Redis
IAM_REDIS_IMAGE_NAME=redis:7.2.5-alpine3.20
IAM_REDIS_CONTAINER_HOST=redis-iam
IAM_REDIS_CONTAINER_PORT=6379
IAM_REDIS_HOST=localhost
IAM_REDIS_PORT=63791
IAM_REDIS_CONNECTION_TIMEOUT=10s
IAM_REDIS_MAX_IDLE=10
IAM_REDIS_IDLE_TIMEOUT=10s

# Session
IAM_SESSION_TTL=24h

